<?xml version="1.0" encoding="utf-8"?>
<!-- Include-only: the DataStore settings files + the library snapshot; the
     database, audio and device-local SharedPreferences caches (widget
     state, notification watermark) are implicitly left out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="file" path="cloud_backup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="file" path="cloud_backup/" />
    </device-transfer>
</data-extraction-rules>
